<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="AutoCAD"
    ProductType="Application"
    Name="GoogleSatelliteCAD"
    AppVersion="1.0.0"
    Author="SalohiyatDP"
    Description="AutoCAD uchun Google Satellite fon xarita plagini">

  <CompanyDetails Name="SalohiyatDP"/>

  <!-- ================= AutoCAD 2018-2024 va Mechanical 2021 (.NET Framework 4.8) =================
       R22.0 = 2018, R23.0 = 2019, R23.1 = 2020, R24.0 = 2021 (incl. Mechanical),
       R24.1 = 2022, R24.2 = 2023, R24.3 = 2024.
       Platform="AutoCAD*" verticallarni (Mechanical, Civil 3D, Map, MEP ...) ham qamrab oladi. -->
  <Components Description="AutoCAD 2018-2024 / Mechanical 2021 (.NET Framework)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R22.0" SeriesMax="R24.3"/>
    <ComponentEntry
        AppName="GoogleSatelliteCAD"
        ModuleName="./Contents/GoogleSatelliteCAD.dll"
        LoadOnAutoCADStartup="True"/>
  </Components>

  <!-- ========================= AutoCAD 2025+ (.NET 8) ========================= -->
  <Components Description="AutoCAD 2025+ (.NET 8)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0"/>
    <ComponentEntry
        AppName="GoogleSatelliteCAD"
        ModuleName="./Contents/GoogleSatelliteCAD_2025.dll"
        LoadOnAutoCADStartup="True"/>
  </Components>

</ApplicationPackage>
