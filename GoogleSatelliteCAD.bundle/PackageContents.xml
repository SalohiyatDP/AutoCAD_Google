<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="AutoCAD"
    ProductType="Application"
    Name="GoogleSatelliteCAD"
    AppVersion="1.0.0"
    Author="SalohiyatDP"
    Description="AutoCAD uchun Google Satellite fon xarita plagini">

  <CompanyDetails Name="SalohiyatDP"/>

  <!-- ================= AutoCAD 2021-2024 (.NET Framework 4.8) =================
       R24.0 = 2021, R24.1 = 2022, R24.2 = 2023, R24.3 = 2024.
       Platform="AutoCAD*" barcha vertikallarni qamrab oladi: standart AutoCAD,
       Mechanical, Civil 3D, Map 3D, Architecture, MEP, Electrical, Plant 3D, Raster Design.
       Shu yildagi barcha vertikallar bir xil AutoCAD .NET API ishlatgani uchun bitta DLL yetarli. -->
  <Components Description="AutoCAD 2021-2024 va vertikallar (.NET Framework 4.8)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.0" SeriesMax="R24.3"/>
    <ComponentEntry
        AppName="GoogleSatelliteCAD"
        ModuleName="./Contents/GoogleSatelliteCAD.dll"
        LoadOnAutoCADStartup="True"/>
  </Components>

  <!-- ================= AutoCAD 2025-2026 (.NET 8) =================
       R25.0 = 2025, R25.1 = 2026. SeriesMax berilmagan -> 2026 va keyingi R25.x ham qamraladi.
       Platform="AutoCAD*" bu yerda ham barcha vertikallarni qamrab oladi. -->
  <Components Description="AutoCAD 2025-2026 va vertikallar (.NET 8)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0"/>
    <ComponentEntry
        AppName="GoogleSatelliteCAD"
        ModuleName="./Contents/GoogleSatelliteCAD_2025.dll"
        LoadOnAutoCADStartup="True"/>
  </Components>

</ApplicationPackage>
