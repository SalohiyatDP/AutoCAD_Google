<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================================
    AutoCAD 2025-2026 (.NET 8) uchun GoogleSatelliteCAD build'i.
    Barcha vertikallar (Mechanical, Civil 3D, Map 3D, Architecture, MEP, Electrical,
    Plant 3D, Raster Design) 2025-2026 relizlarini ham qamrab oladi.

    ASOSIY loyiha (../GoogleSatelliteCAD/GoogleSatelliteCAD.csproj) AutoCAD 2021-2024
    (.NET Framework 4.8) uchun. Bu loyiha AYNAN SHU manba fayllarni .NET 8 ga qayta
    kompilyatsiya qiladi (**/*.cs glob orqali — yangi fayllar avtomatik qo'shiladi).
    Natija: GoogleSatelliteCAD_2025.dll  (bundle Contents ichiga qo'yiladi; 2025 va 2026).

    Eslatma: AutoCAD.NET 25.0.0 assembly'lari 2026 (R25.1) da ham oldinga mos yuklanadi.
    Agar 2026 uchun aynan o'sha yil paketi kerak bo'lsa, PackageReference versiyasini
    mos ravishda ko'taring.
    ============================================================================
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>GoogleSatelliteCAD</RootNamespace>
    <AssemblyName>GoogleSatelliteCAD_2025</AssemblyName>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Manba tarkibida Properties\AssemblyInfo.cs bor, shuning uchun avtomatik generatsiya o'chirilgan. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Manba fayllar ../GoogleSatelliteCAD dan olinadi (obj/bin chiqarib tashlanadi). -->
  <ItemGroup>
    <Compile Include="..\GoogleSatelliteCAD\**\*.cs"
             Exclude="..\GoogleSatelliteCAD\obj\**\*.cs;..\GoogleSatelliteCAD\bin\**\*.cs" />
  </ItemGroup>

  <!-- AutoCAD 2025 .NET API (net8.0-windows). runtime -> chiqishga nusxalanmaydi. -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="25.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- .NET 8 da System.Management NuGet paketi orqali keladi. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
