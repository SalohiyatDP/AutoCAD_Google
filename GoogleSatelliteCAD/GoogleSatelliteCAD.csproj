<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{B1D7F4A2-6C3E-4E8A-9F2B-7A1C2D3E4F50}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>GoogleSatelliteCAD</RootNamespace>
    <AssemblyName>GoogleSatelliteCAD</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!--
      ===========================================================================
      Bu loyiha AutoCAD 2021-2024 (.NET Framework 4.8) VA ularning barcha vertikal
      mahsulotlari uchun bitta DLL ishlab chiqaradi: AutoCAD, Mechanical, Civil 3D,
      Map 3D, Architecture, MEP, Electrical, Plant 3D, Raster Design.
      (AutoCAD 2025-2026 = .NET 8 uchun alohida: ../build-2025/GoogleSatelliteCAD.2025.csproj.)

      AutoCAD .NET API 2021-2024 oralig'ida oldinga mos (forward-compatible): 2021 ga
      qarshi yig'ilgan DLL 2022/2023/2024 da ham yuklanadi.

      Managed assembly'lar joylashgan papkani tanlash:
        - AcadVersion (2021..2024) berilsa, standart yo'l shu versiyaga moslanadi.
        - Yoki AutoCADReferencePath ni to'g'ridan-to'g'ri bering (vertikal mahsulotlar uchun
          o'rnatish papkasi boshqacha bo'lishi mumkin). Masalan:
            msbuild /p:AcadVersion=2024
            msbuild /p:AutoCADReferencePath="C:\Program Files\Autodesk\AutoCAD 2022\"
            msbuild /p:AutoCADReferencePath="C:\Program Files\Autodesk\ACADM 2021\"        (Mechanical)
            msbuild /p:AutoCADReferencePath="C:\Program Files\Autodesk\AutoCAD 2023\C3D\"  (Civil 3D)
      ===========================================================================
    -->
    <AcadVersion Condition=" '$(AcadVersion)' == '' ">2021</AcadVersion>
    <AutoCADReferencePath Condition=" '$(AutoCADReferencePath)' == '' ">C:\Program Files\Autodesk\AutoCAD $(AcadVersion)\</AutoCADReferencePath>
  </PropertyGroup>

  <!-- AutoCAD plaginlar 64-bitli bo'lishi shart (AutoCAD 2021 faqat x64) -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <!-- ============================ .NET tizim referenslari ============================ -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <!-- Litsenziya moduli uchun: Machine ID (CPU/BIOS) WMI orqali olinadi. -->
    <Reference Include="System.Management" />
    <!-- WPF Sozlamalar oynasi uchun -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!-- ============================ AutoCAD 2021-2024 referenslari ============================
       $(AutoCADReferencePath) papkasidagi managed assembly'lar (barcha vertikallar uchun bir xil).
       MUHIM: Ushbu DLL'lar "Copy Local = False" (Private=False) bo'lishi shart.
       Aks holda AutoCAD ishga tushganda assembly nizolari (conflict) yuzaga keladi.
  -->
  <ItemGroup>
    <Reference Include="acmgd">
      <HintPath>$(AutoCADReferencePath)acmgd.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCADReferencePath)acdbmgd.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCADReferencePath)accoremgd.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AutoCADReferencePath)AdWindows.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="AcWindows">
      <HintPath>$(AutoCADReferencePath)AcWindows.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <!-- ============================ Loyiha manba fayllari ============================ -->
  <ItemGroup>
    <Compile Include="Core\PluginEntry.cs" />
    <Compile Include="Core\HostProduct.cs" />
    <Compile Include="Core\ConfigManager.cs" />

    <Compile Include="Licensing\LicenseCodec.cs" />
    <Compile Include="Licensing\MachineIdProvider.cs" />
    <Compile Include="Licensing\LicenseManager.cs" />
    <Compile Include="Licensing\LicenseGate.cs" />
    <Compile Include="Licensing\LicenseCommands.cs" />
    <Compile Include="Core\PluginContext.cs" />
    <Compile Include="Core\Logger.cs" />

    <Compile Include="Projection\Ellipsoid.cs" />
    <Compile Include="Projection\CoordinateSystem.cs" />
    <Compile Include="Projection\IProjection.cs" />
    <Compile Include="Projection\Mercator.cs" />
    <Compile Include="Projection\Pulkovo1942.cs" />
    <Compile Include="Projection\CoordinateTransform.cs" />

    <Compile Include="TileEngine\TileInfo.cs" />
    <Compile Include="TileEngine\TileSystem.cs" />
    <Compile Include="TileEngine\ITileCache.cs" />
    <Compile Include="TileEngine\TileCache.cs" />
    <Compile Include="TileEngine\ITileDownloader.cs" />
    <Compile Include="TileEngine\TileDownloader.cs" />
    <Compile Include="TileEngine\TileManager.cs" />

    <Compile Include="Drawing\LayerManager.cs" />
    <Compile Include="Drawing\RasterManager.cs" />
    <Compile Include="Drawing\ViewportTracker.cs" />

    <Compile Include="Commands\MapOnCommand.cs" />
    <Compile Include="Commands\MapOffCommand.cs" />
    <Compile Include="Commands\CacheClearCommand.cs" />

    <Compile Include="UI\RibbonUI.cs" />
    <Compile Include="UI\AboutWindow.cs" />
    <Compile Include="UI\ActivationWindow.cs" />
    <Compile Include="UI\SettingsViewModel.cs" />
    <Compile Include="UI\SettingsWindow.cs" />

    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
